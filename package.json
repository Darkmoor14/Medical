  },
  "homepage": "https://github.com/Darkmoor14/Medical#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-web": "^1.30.0",
    "openmed": "^2.5.0"
  },
